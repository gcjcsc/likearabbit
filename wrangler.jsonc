// Cloudflare Workers config: src/worker.js checks the password and answers /api from the D1 database,
// then serves the app in ./public
{
  "name": "likearabbit",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "likearabbit",
      "database_id": "57188787-c3de-4a15-80e3-b36f0aa8cab3",
      "migrations_dir": "migrations"
    },
    {
      // Photo files only, kept apart so the herd database stays small (free plan: 500 MB per database)
      "binding": "PHOTOS",
      "database_name": "likearabbit-photos",
      "database_id": "6102d109-9ba8-43b1-b174-0faaa6214b81",
      "migrations_dir": "migrations-photos"
    }
  ],
  // Workers AI, for reading photos of paper pedigrees (src/scan.js)
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
